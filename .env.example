# Copy to .env and fill in. `.env` is git-ignored.
#
# Leave ANTHROPIC_API_KEY empty (or delete it) to run everything in mock mode.
# If it is set, it is validated on startup with a zero-token GET /v1/models
# call; an invalid, unauthorised, or unreachable key falls back to mock mode
# instead of failing the run.
ANTHROPIC_API_KEY=

# Models. claude-opus-5 is the default for both roles.
RC_MODEL_COORDINATOR=claude-opus-5
RC_MODEL_SUBAGENT=claude-opus-5

# Thinking effort: low | medium | high | xhigh | max
RC_EFFORT_COORDINATOR=high
RC_EFFORT_SUBAGENT=medium

# Use Anthropic's server-side web_search tool in live mode. Set to false to
# keep live runs off the network (the web_researcher then has no search tool).
RC_ENABLE_WEB_SEARCH=true

# Per-subagent deadline, in seconds.
RC_SUBAGENT_TIMEOUT=120

# Cap on coordinator delegation rounds.
RC_MAX_ROUNDS=4

# --- 2_tool_design_and_MCP_integration -------------------------------------
# Credential the project-scoped .mcp.json expands into the server's env.
TRACKER_API_TOKEN=
TRACKER_BASE_URL=https://tracker.internal.example

# Force tool failures to exercise the structured error path.
# TRACKER_SIMULATE=transient|permission|validation
# TRACKER_SIMULATE_TOOL=search_issues
TRACKER_SIMULATE=
TRACKER_SIMULATE_TOOL=

# Model used by the tool-selection eval in live mode.
MCP_EVAL_MODEL=claude-opus-5

# --- 4_prompt_engineering_and_structured_output ----------------------------
IE_MODEL=claude-opus-5
# Thinking effort for extraction calls: low | medium | high | xhigh | max
IE_EFFORT=medium
# Any field (or line item) below this confidence routes the document to review.
IE_CONFIDENCE_THRESHOLD=0.8
# Validation-retry budget per document, counting the first attempt.
IE_MAX_ATTEMPTS=3
IE_REQUEST_TIMEOUT=120
# Server-side refusal fallback on synchronous calls (not accepted by Batches).
IE_REFUSAL_FALLBACK=true
# Batch polling: seconds between status checks, and the deadline before giving up.
IE_BATCH_POLL_INTERVAL=30
IE_BATCH_POLL_TIMEOUT=1800
IE_BATCH_MAX_ROUNDS=3
